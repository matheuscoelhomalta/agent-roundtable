{
  "claude": {
    "label": "Claude Code",
    "headless": {
      "start": [
        "claude",
        "-p",
        "--output-format",
        "json",
        "--permission-mode",
        "plan",
        "--safe-mode",
        "--restricted",
        "--strict-mcp-config",
        "--mcp-config",
        "{\"mcpServers\":{}}",
        "--tools",
        ""
      ],
      "resume": [
        "claude",
        "-p",
        "--output-format",
        "json",
        "--permission-mode",
        "plan",
        "--safe-mode",
        "--restricted",
        "--strict-mcp-config",
        "--mcp-config",
        "{\"mcpServers\":{}}",
        "--tools",
        "",
        "--resume",
        "{session}"
      ],
      "input": "stdin",
      "output": "json"
    }
  },
  "gemini": {
    "label": "Gemini (Antigravity)",
    "headless": {
      "start": [
        "agy",
        "--input-format",
        "stream-json",
        "--output-format",
        "stream-json",
        "--mode",
        "plan",
        "--disable-slash-commands",
        "--settings",
        "{skill}/gemini-permissions.json"
      ],
      "resume": [
        "agy",
        "--input-format",
        "stream-json",
        "--output-format",
        "stream-json",
        "--mode",
        "plan",
        "--disable-slash-commands",
        "--settings",
        "{skill}/gemini-permissions.json",
        "--conversation",
        "{session}"
      ],
      "input": "antigravity-stream",
      "output": "antigravity-jsonl"
    },
    "model": "gemini-4-argon-medium"
  },
  "codex": {
    "label": "Codex",
    "headless": {
      "start": [
        "codex",
        "exec",
        "--json",
        "--skip-git-repo-check",
        "--ignore-user-config",
        "--ignore-rules",
        "--disable",
        "shell_tool",
        "--disable",
        "shell_snapshot",
        "--disable",
        "code_mode_host",
        "--disable",
        "code_mode",
        "--disable",
        "apps",
        "--disable",
        "plugins",
        "--disable",
        "remote_plugin",
        "--disable",
        "hooks",
        "--disable",
        "multi_agent",
        "-c",
        "approval_policy=\"never\"",
        "-c",
        "web_search=\"disabled\"",
        "--sandbox",
        "read-only",
        "-C",
        "{cwd}",
        "-o",
        "{out}",
        "-"
      ],
      "resume": [
        "codex",
        "exec",
        "resume",
        "--json",
        "--skip-git-repo-check",
        "--ignore-user-config",
        "--ignore-rules",
        "--disable",
        "shell_tool",
        "--disable",
        "shell_snapshot",
        "--disable",
        "code_mode_host",
        "--disable",
        "code_mode",
        "--disable",
        "apps",
        "--disable",
        "plugins",
        "--disable",
        "remote_plugin",
        "--disable",
        "hooks",
        "--disable",
        "multi_agent",
        "-c",
        "approval_policy=\"never\"",
        "-c",
        "web_search=\"disabled\"",
        "-c",
        "sandbox_mode=\"read-only\"",
        "-o",
        "{out}",
        "{session}",
        "-"
      ],
      "input": "stdin",
      "output": "codex-jsonl"
    },
    "model": "gpt-6.1-sol"
  }
}
